{
  "name": "git-weft",
  "displayName": "Git Weft",
  "icon": "media/icon.png",
  "description": "A fast Git commit graph for VS Code, with the operations you would reach for while looking at it.",
  "version": "0.6.0",
  "publisher": "HouseAlwaysWin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "history",
    "log",
    "commit"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:weft.graph"
  ],
  "contributes": {
    "commands": [
      {
        "command": "weft.openGraph",
        "title": "Open Git Graph",
        "category": "Git Weft",
        "_iconNote": "A path rather than a codicon: this button sits in Source Control's own title bar, where $(git-branch) is indistinguishable from git's. The extension's icon says whose button it is.",
        "icon": "media/icon.svg"
      },
      {
        "command": "weft.refresh",
        "title": "Refresh",
        "category": "Git Weft",
        "icon": "$(refresh)"
      },
      {
        "command": "weft.showGitLog",
        "title": "Show Git Command Log",
        "category": "Git Weft"
      },
      {
        "command": "weft.showAllRefs",
        "title": "Show All Branches & Tags",
        "category": "Git Weft",
        "icon": "$(pass)"
      },
      {
        "command": "weft.stash",
        "title": "Stash Changes",
        "category": "Git Weft",
        "icon": "$(archive)"
      },
      {
        "command": "weft.filterRefs",
        "title": "Filter Branches & Tags…",
        "category": "Git Weft",
        "icon": "$(filter)"
      },
      {
        "command": "weft.toggleFileBlame",
        "title": "Toggle File Blame",
        "category": "Git Weft",
        "icon": "$(list-selection)"
      },
      {
        "command": "weft.revealCommit",
        "title": "Show Commit in the Graph",
        "category": "Git Weft"
      },
      {
        "command": "weft.untickAllRefs",
        "title": "Untick All Branches & Tags",
        "category": "Git Weft",
        "icon": "$(circle-slash)"
      },
      {
        "command": "weft.sortRefsByRecent",
        "title": "Sort Branches & Tags by Most Recent",
        "category": "Git Weft",
        "icon": "$(history)"
      },
      {
        "command": "weft.sortRefsByName",
        "title": "Sort Branches & Tags by Name",
        "category": "Git Weft",
        "icon": "$(symbol-text)"
      },
      {
        "command": "weft.listTickedRefs",
        "title": "List Only Ticked Branches & Tags",
        "category": "Git Weft",
        "icon": "$(checklist)"
      },
      {
        "command": "weft.listAllRefs",
        "title": "List Every Branch & Tag",
        "category": "Git Weft",
        "icon": "$(list-unordered)"
      },
      {
        "command": "weft.showCurrentRefOnly",
        "title": "Show Only the Current Branch",
        "category": "Git Weft",
        "icon": "$(target)"
      },
      {
        "command": "weft.filterAuthors",
        "title": "Filter Authors…",
        "category": "Git Weft",
        "icon": "$(filter)"
      },
      {
        "command": "weft.showOnlyListedAuthors",
        "title": "Show Only Who Is Listed",
        "category": "Git Weft",
        "icon": "$(filter-filled)"
      },
      {
        "command": "weft.showAllAuthors",
        "title": "Show All Authors",
        "category": "Git Weft",
        "icon": "$(clear-all)"
      },
      {
        "command": "weft.groupAuthor",
        "title": "Group With…",
        "category": "Git Weft"
      },
      {
        "command": "weft.ungroupAuthor",
        "title": "Remove from Group",
        "category": "Git Weft"
      },
      {
        "command": "weft.sortAuthorsByName",
        "title": "Sort Authors by Name",
        "category": "Git Weft",
        "icon": "$(symbol-text)"
      },
      {
        "command": "weft.sortAuthorsByCommits",
        "title": "Sort Authors by Commits",
        "category": "Git Weft",
        "icon": "$(list-ordered)"
      },
      {
        "command": "weft.deleteRef",
        "title": "Delete",
        "category": "Git Weft"
      },
      {
        "command": "weft.deleteRemoteRef",
        "title": "Delete on Remote...",
        "category": "Git Weft"
      },
      {
        "command": "weft.checkoutRef",
        "title": "Checkout",
        "category": "Git Weft"
      },
      {
        "command": "weft.showOnlyRef",
        "title": "Show Only This",
        "category": "Git Weft"
      },
      {
        "command": "weft.showOnlyListedRefs",
        "title": "Show Only What Is Listed",
        "category": "Git Weft",
        "icon": "$(filter-filled)"
      },
      {
        "command": "weft.clearFilters",
        "title": "Clear All Filters",
        "category": "Git Weft",
        "icon": "$(clear-all)"
      },
      {
        "command": "weft.filesAsTree",
        "title": "View Changed Files as Tree",
        "category": "Git Weft",
        "icon": "$(list-tree)"
      },
      {
        "command": "weft.filesAsList",
        "title": "View Changed Files as List",
        "category": "Git Weft",
        "icon": "$(list-flat)"
      },
      {
        "command": "weft.openCommitFile",
        "title": "Open Changes",
        "category": "Git Weft"
      },
      {
        "command": "weft.copyRefName",
        "title": "Copy Name",
        "category": "Git Weft"
      },
      {
        "command": "weft.copyFullRefName",
        "title": "Copy Full Ref Name",
        "category": "Git Weft"
      },
      {
        "command": "weft.copyFilePath",
        "title": "Copy Path",
        "category": "Git Weft"
      },
      {
        "command": "weft.copyAbsoluteFilePath",
        "title": "Copy Absolute Path",
        "category": "Git Weft"
      },
      {
        "command": "weft.showFileHistory",
        "title": "Show File History",
        "category": "Git Weft",
        "icon": "$(history)"
      },
      {
        "command": "weft.fetch",
        "title": "Fetch",
        "category": "Git Weft",
        "icon": "$(cloud-download)"
      },
      {
        "command": "weft.pull",
        "title": "Pull",
        "category": "Git Weft",
        "icon": "$(arrow-down)"
      },
      {
        "command": "weft.push",
        "title": "Push",
        "category": "Git Weft",
        "icon": "$(arrow-up)"
      },
      {
        "command": "weft.manageRemotes",
        "title": "Manage Remotes...",
        "category": "Git Weft"
      },
      {
        "command": "weft.pushForce",
        "title": "Force Push (with lease)",
        "category": "Git Weft"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "weft.openGraph",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "weft.openCommitFile",
          "when": "false"
        },
        {
          "_comment": "Takes a sha and a repository root, so there is nothing to type it with.",
          "command": "weft.revealCommit",
          "when": "false"
        },
        {
          "command": "weft.showFileHistory",
          "when": "false"
        },
        {
          "_comment": "Both act on the row that was right-clicked, so there is nothing to type them with.",
          "command": "weft.groupAuthor",
          "when": "false"
        },
        {
          "command": "weft.ungroupAuthor",
          "when": "false"
        },
        {
          "command": "weft.copyRefName",
          "when": "false"
        },
        {
          "command": "weft.copyFullRefName",
          "when": "false"
        },
        {
          "command": "weft.copyFilePath",
          "when": "false"
        },
        {
          "command": "weft.copyAbsoluteFilePath",
          "when": "false"
        },
        {
          "command": "weft.checkoutRef",
          "when": "false"
        },
        {
          "command": "weft.deleteRef",
          "when": "false"
        },
        {
          "command": "weft.deleteRemoteRef",
          "when": "false"
        },
        {
          "command": "weft.showOnlyRef",
          "when": "false"
        },
        {
          "command": "weft.showOnlyListedRefs",
          "when": "weft.refsListFiltered"
        },
        {
          "command": "weft.refresh",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.stash",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.fetch",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.pull",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.push",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.pushForce",
          "when": "weft.graphVisible"
        },
        {
          "command": "weft.manageRemotes",
          "when": "weft.graphVisible"
        }
      ],
      "editor/context": [
        {
          "command": "weft.toggleFileBlame",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "navigation@100"
        },
        {
          "command": "weft.showFileHistory",
          "when": "editorTextFocus && resourceScheme == file && weft.hasRepository",
          "group": "navigation@101"
        }
      ],
      "explorer/context": [
        {
          "command": "weft.showFileHistory",
          "when": "!explorerResourceIsFolder && resourceScheme == file && weft.hasRepository",
          "group": "weft@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "weft.showFileHistory",
          "when": "resourceScheme == file && weft.hasRepository",
          "group": "weft@1"
        }
      ],
      "editor/title": [
        {
          "command": "weft.fetch",
          "when": "activeWebviewPanelId == weft.graph",
          "group": "navigation@1"
        },
        {
          "command": "weft.pull",
          "when": "activeWebviewPanelId == weft.graph",
          "group": "navigation@2"
        },
        {
          "command": "weft.push",
          "when": "activeWebviewPanelId == weft.graph",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "weft.showFileHistory",
          "when": "view == weft.files && viewItem == weftFile",
          "group": "navigation@1"
        },
        {
          "command": "weft.copyFilePath",
          "when": "view == weft.files && viewItem == weftFile",
          "group": "copy@1"
        },
        {
          "command": "weft.copyAbsoluteFilePath",
          "when": "view == weft.files && viewItem == weftFile",
          "group": "copy@2"
        },
        {
          "command": "weft.deleteRef",
          "when": "view == weft.refs && viewItem =~ /^weftRef(Local|Tag)$/",
          "group": "danger@1"
        },
        {
          "command": "weft.deleteRemoteRef",
          "when": "view == weft.refs && viewItem == weftRefRemote",
          "group": "danger@1"
        },
        {
          "command": "weft.copyRefName",
          "when": "view == weft.refs && viewItem =~ /^weftRef/",
          "group": "copy@1"
        },
        {
          "command": "weft.copyFullRefName",
          "when": "view == weft.refs && viewItem =~ /^weftRef/",
          "group": "copy@2"
        },
        {
          "command": "weft.checkoutRef",
          "when": "view == weft.refs && viewItem =~ /^weftRef/",
          "group": "navigation@1"
        },
        {
          "command": "weft.showOnlyRef",
          "when": "view == weft.refs && viewItem =~ /^weftRef/",
          "group": "filter@1"
        },
        {
          "command": "weft.groupAuthor",
          "when": "view == weft.authors && viewItem =~ /^weftAuthor/",
          "group": "group@1"
        },
        {
          "command": "weft.ungroupAuthor",
          "when": "view == weft.authors && viewItem =~ /Custom$/",
          "group": "group@2"
        },
        {
          "command": "weft.showAllRefs",
          "when": "view == weft.refs && viewItem =~ /^weftRef/",
          "group": "filter@2"
        }
      ],
      "view/title": [
        {
          "command": "weft.filterRefs",
          "when": "view == weft.refs",
          "group": "navigation@1"
        },
        {
          "command": "weft.showOnlyListedRefs",
          "when": "view == weft.refs && weft.refsListFiltered",
          "group": "navigation@2"
        },
        {
          "command": "weft.sortRefsByRecent",
          "when": "view == weft.refs && !weft.refsByRecent",
          "group": "listing@1"
        },
        {
          "command": "weft.sortRefsByName",
          "when": "view == weft.refs && weft.refsByRecent",
          "group": "listing@1"
        },
        {
          "command": "weft.listTickedRefs",
          "when": "view == weft.refs && !weft.refsTickedOnly",
          "group": "listing@2"
        },
        {
          "command": "weft.listAllRefs",
          "when": "view == weft.refs && weft.refsTickedOnly",
          "group": "listing@2"
        },
        {
          "command": "weft.showAllRefs",
          "when": "view == weft.refs",
          "group": "navigation@3"
        },
        {
          "command": "weft.untickAllRefs",
          "when": "view == weft.refs",
          "group": "navigation@5"
        },
        {
          "command": "weft.showCurrentRefOnly",
          "when": "view == weft.refs",
          "group": "navigation@4"
        },
        {
          "command": "weft.openGraph",
          "when": "view == weft.refs",
          "group": "open@1"
        },
        {
          "command": "weft.filterAuthors",
          "when": "view == weft.authors",
          "group": "navigation@1"
        },
        {
          "command": "weft.showOnlyListedAuthors",
          "when": "view == weft.authors && weft.authorsListFiltered",
          "group": "navigation@2"
        },
        {
          "command": "weft.showAllAuthors",
          "when": "view == weft.authors",
          "group": "navigation@2"
        },
        {
          "command": "weft.sortAuthorsByName",
          "when": "view == weft.authors && !weft.authorsByName",
          "group": "navigation@3"
        },
        {
          "command": "weft.sortAuthorsByCommits",
          "when": "view == weft.authors && weft.authorsByName",
          "group": "navigation@3"
        },
        {
          "command": "weft.filesAsList",
          "when": "view == weft.files && weft.filesAsTree",
          "group": "navigation@1"
        },
        {
          "command": "weft.filesAsTree",
          "when": "view == weft.files && !weft.filesAsTree",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Weft",
      "properties": {
        "weft.pageSize": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 20000,
          "markdownDescription": "How many commits to load per page. The first page is what you wait for on open."
        },
        "weft.rowHeight": {
          "type": "number",
          "default": 24,
          "minimum": 16,
          "maximum": 48,
          "description": "Height of a single commit row, in pixels."
        },
        "weft.maxConcurrentGitProcesses": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Upper bound on git processes Weft runs at once."
        },
        "weft.refreshDebounceMs": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "maximum": 5000,
          "description": "Quiet period after repository changes before the graph reloads."
        },
        "weft.authorColors": {
          "type": "boolean",
          "default": true,
          "description": "Give each author their own colour in the commit list. Always off in high contrast themes."
        },
        "weft.inlineBlame": {
          "type": "boolean",
          "default": true,
          "description": "Show who last changed the line the cursor is on, at the end of that line."
        },
        "weft.networkIdleTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 3600,
          "markdownDescription": "Give up on a fetch, pull or push after this many seconds with **no output at all**. This is idle time, not total time, so a slow but live transfer is never cut off. `0` waits forever."
        },
        "weft.autoFetchMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1440,
          "markdownDescription": "Fetch from every remote this often, in minutes. `0` never fetches on its own.\n\nA remote-tracking ref like `origin/main` only moves when something fetches, so the graph - and the ahead/behind counts beside the title - are only ever as current as the last fetch. Weft picks up whatever moves them, including VS Code's own `#git.autofetch#`, so turn this on only if you would rather Weft did it."
        },
        "weft.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a Weft button in the status bar when the workspace has a git repository."
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "weft.files",
          "name": "Commit Files",
          "icon": "media/weft.svg",
          "contextualTitle": "Weft",
          "visibility": "collapsed",
          "when": "weft.hasRepository"
        },
        {
          "id": "weft.refs",
          "name": "Branches & Tags",
          "icon": "media/weft.svg",
          "contextualTitle": "Weft",
          "visibility": "collapsed",
          "when": "weft.hasRepository"
        },
        {
          "id": "weft.authors",
          "name": "Authors",
          "icon": "media/weft.svg",
          "contextualTitle": "Weft",
          "visibility": "collapsed",
          "when": "weft.hasRepository"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test \"test/**/*.test.ts\" && node scripts/color-check.mjs && node scripts/column-check.mjs && node scripts/icon-check.mjs && node scripts/load-check.mjs --watch && node scripts/load-check.mjs --break-view=weft.files",
    "vscode:prepublish": "node esbuild.mjs --production",
    "smoke": "node scripts/smoke.mjs",
    "load-check": "node scripts/load-check.mjs",
    "package": "vsce package --no-dependencies",
    "icon-check": "node scripts/icon-check.mjs",
    "color-check": "node scripts/color-check.mjs",
    "column-check": "node scripts/column-check.mjs",
    "test:unit": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "@vscode/vsce": "^3.6.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Weft runs the git CLI, which honours repository-local configuration."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Weft needs a real filesystem and a local git executable."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HouseAlwaysWin/Git-Weft.git"
  }
}

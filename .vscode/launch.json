{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 opens a second VS Code window with Weft loaded. The second argument is the folder that
      // window opens - without it the dev host starts empty, Weft finds no repository, and it
      // looks like the extension did not load at all.
      "name": "Run Weft (on GimmeCapture)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "D:\\ShittyProject\\dlp-develop"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build"
    },
    {
      "name": "Run Weft (pick a folder)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build"
    }
  ]
}